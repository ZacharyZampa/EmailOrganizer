      margin-top: 4px;
  }
  .cleanup-card {
      display: block;
      text-decoration: none;
      color: inherit;
      border-radius: 10px;
      padding: 10px 12px;
      margin-bottom: 8px;
      background: #f1f3f4;
  }
  .cleanup-meta {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: #777;
      margin-bottom: 3px;
  }
  .cleanup-title {
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 2px;
  }
  .cleanup-sender {
      font-size: 12px;
      color: #666;
  }
  .volume-list {
      margin-top: 8px;
  }
  .volume-card {
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 8px;
      background: #fff3e0;
      border-left: 3px solid #ff9800;
  }
  .volume-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 4px;
  }
  .volume-flag {
      font-size: 16px;
  }
  .volume-sender {
      flex: 1;
      font-weight: 600;
      font-size: 14px;
  }
  .volume-count {
      font-size: 12px;
