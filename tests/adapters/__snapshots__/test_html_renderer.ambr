  </style>
  </head>
  <body>
  <div class="container">
      <div class="title">📬 Daily Email Digest</div>
      <div class="subtitle">AI summary of today's emails</div>
      
      <div class="category-block">
          <div class="category-header">💼 Work</div>
      
          <a href="https://mail.google.com/mail/u/0/#inbox/2" class="card" style="border-left: 4px solid #1a73e8; background: #e8f0fe">
              <div class="card-meta">
                  <span class="sender">Boss</span>
                  <span class="priority">P5</span>
              </div>
              <div class="card-title">Important Work</div>
              <div class="card-summary">Work summary high priority</div>
          </a>
      </div>
      <div class="category-block">
          <div class="category-header">🏷️ Promo</div>
      
          <a href="https://mail.google.com/mail/u/0/#inbox/1" class="card" style="border-left: 4px solid #e37400; background: #fef3e2">
              <div class="card-meta">
                  <span class="sender">Promo Sender</span>
                  <span class="priority">P1</span>
              </div>
              <div class="card-title">Promo Title</div>
              <div class="card-summary">Promo summary</div>
          </a>
      </div>
      
      <div class="section-heading">📬 Recent Email Patterns</div>
      <p class="section-subtitle">Senders who emailed you 3+ times in the past 3 days.</p>
      <div class="recent-agg-list">
          
          <div class="recent-agg-card">
              <div class="agg-header">
                  <span class="agg-emoji">📰</span>
                  <span class="agg-sender">newsletter@example.com</span>
              </div>
              <div class="agg-info">
                  <span class="agg-count">3 emails in past 3 days</span>
                  <span class="agg-category">newsletter</span>
              </div>
              <div class="agg-actions">
                  <a href="https://mail.google.com/mail/u/0/#search/from:newsletter@example.com" class="action-btn delete-btn">Delete All</a> <a href="https://mail.google.com/mail/u/0/#inbox/2" class="action-btn unsub-btn">View to Unsubscribe</a>
              </div>
          </div>
      
      </div>
      
      
      <div class="section-heading">📊 High Volume Senders (All Time)</div>
      <p class="section-subtitle">Senders with 10+ emails total. Consider unsubscribing from newsletters.</p>
      <div class="volume-list">
          
          <div class="volume-card">
              <div class="volume-header">
                  <span class="volume-flag">🚨</span>
                  <span class="volume-sender">newsletter@example.com</span>
                  <span class="volume-count">25 emails</span>
              </div>
              <div class="volume-breakdown">newsletter: 25</div>
          </div>
      
          <div class="volume-card">
              <div class="volume-header">
                  <span class="volume-flag">⚠️</span>
                  <span class="volume-sender">promo@shop.com</span>
                  <span class="volume-count">15 emails</span>
              </div>
              <div class="volume-breakdown">promo: 15</div>
          </div>
      
      </div>
      
      
      <div class="section-heading">🧹 Tidy up older mail (30+ days)</div>
      <p class="section-subtitle">Quick suggestions for messages that have been sitting for a while.</p>
      <div class="cleanup-list">
          
          <a href="https://mail.google.com/mail/u/0/#inbox/10" class="cleanup-card">
              <div class="cleanup-meta">
                  <span class="cleanup-date">2025-01-01</span>
                  <span class="cleanup-action">Delete</span>
              </div>
              <div class="cleanup-title">Old subject</div>
              <div class="cleanup-sender">Old Newsletter</div>
          </a>
      
      </div>
      
      <div class="footer">Generated locally · 2 email(s) summarised</div>
  </div>
  </body>
  </html>
  
  '''
